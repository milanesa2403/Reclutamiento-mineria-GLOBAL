#!/bin/bash
set -euo pipefail

dnf install -y docker openssl jq
systemctl enable --now docker

mkdir -p /opt/plataforma/html /opt/plataforma/certs

TOKEN=$(curl -sS -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
INSTANCE_ID=$(curl -sS -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/instance-id)

openssl req -x509 -nodes -newkey rsa:2048 -days 365 \
  -subj "/CN=$INSTANCE_ID" \
  -keyout /opt/plataforma/certs/servidor.key \
  -out /opt/plataforma/certs/servidor.crt

docker network create plataforma || true

cat > /opt/plataforma/desplegar.sh <<'SCRIPT'
#!/bin/bash
set -euo pipefail

REGION="${region}"
LOG_GROUP="${log_group}"
TOKEN=$(curl -sS -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
INSTANCE_ID=$(curl -sS -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/instance-id)
ZONE=$(curl -sS -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/placement/availability-zone)
ETIQUETA=$(aws ssm get-parameter --region "$REGION" --name "${image_parameter}" --query Parameter.Value --output text)

docker rm -f backend web >/dev/null 2>&1 || true

if [ "$ETIQUETA" != "ninguna" ]; then
  aws ecr get-login-password --region "$REGION" | docker login --username AWS --password-stdin "${ecr_registry}"
  SECRETO=$(aws secretsmanager get-secret-value --region "$REGION" --secret-id "${db_secret_arn}" --query SecretString --output text)
  JWT=$(aws ssm get-parameter --region "$REGION" --name "${jwt_parameter}" --with-decryption --query Parameter.Value --output text)

  umask 077
  cat > /opt/plataforma/backend.env <<ENV
DB_URL=jdbc:postgresql://${db_host}:5432/${db_name}?sslmode=require
DB_USERNAME=$(echo "$SECRETO" | jq -r .username)
DB_PASSWORD=$(echo "$SECRETO" | jq -r .password)
JWT_SECRET=$JWT
AWS_REGION=$REGION
APP_S3_BUCKET=${cvs_bucket}
ENV
  umask 022

  docker pull "${ecr_repository}:$ETIQUETA"
  docker run -d --name backend --network plataforma --restart unless-stopped \
    --env-file /opt/plataforma/backend.env \
    --log-driver=awslogs --log-opt awslogs-region="$REGION" \
    --log-opt awslogs-group="$LOG_GROUP" --log-opt awslogs-stream="$INSTANCE_ID-backend" \
    "${ecr_repository}:$ETIQUETA"

  cat > /opt/plataforma/nginx.conf <<'NGINX'
server {
    listen 443 ssl;
    ssl_certificate /etc/nginx/certs/servidor.crt;
    ssl_certificate_key /etc/nginx/certs/servidor.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 6m;

    location / {
        proxy_pass http://backend:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }
}
NGINX
else
  cat > /opt/plataforma/html/index.html <<HTML
<!DOCTYPE html>
<html lang="es">
<head><meta charset="utf-8"><title>Reclutamiento Minero</title></head>
<body>
<h1>Plataforma Global de Reclutamiento Minero</h1>
<p>Instancia $INSTANCE_ID en la zona $ZONE</p>
</body>
</html>
HTML

  cat > /opt/plataforma/nginx.conf <<'NGINX'
server {
    listen 443 ssl;
    ssl_certificate /etc/nginx/certs/servidor.crt;
    ssl_certificate_key /etc/nginx/certs/servidor.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    location = /api/health {
        default_type application/json;
        return 200 '{"status":"UP"}';
    }

    location / {
        root /usr/share/nginx/html;
        index index.html;
    }
}
NGINX
fi

docker run -d --name web --network plataforma --restart unless-stopped -p 443:443 \
  -v /opt/plataforma/nginx.conf:/etc/nginx/conf.d/default.conf:ro \
  -v /opt/plataforma/html:/usr/share/nginx/html:ro \
  -v /opt/plataforma/certs:/etc/nginx/certs:ro \
  --log-driver=awslogs --log-opt awslogs-region="$REGION" \
  --log-opt awslogs-group="$LOG_GROUP" --log-opt awslogs-stream="$INSTANCE_ID" \
  public.ecr.aws/nginx/nginx:stable-alpine
SCRIPT

chmod 700 /opt/plataforma/desplegar.sh
/opt/plataforma/desplegar.sh
