{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StateBucketList",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::<TF_STATE_BUCKET>",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "lab09/dev",
            "lab09/dev/*"
          ]
        }
      }
    },
    {
      "Sid": "StateObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::<TF_STATE_BUCKET>/lab09/dev/terraform.tfstate",
        "arn:aws:s3:::<TF_STATE_BUCKET>/lab09/dev/terraform.tfstate.tflock"
      ]
    },
    {
      "Sid": "ServiciosDelAvance",
      "Effect": "Allow",
      "Action": [
        "ec2:*",
        "elasticloadbalancing:*",
        "autoscaling:*",
        "rds:*",
        "s3:*",
        "sns:*",
        "kms:*",
        "logs:*",
        "cloudwatch:*",
        "cloudtrail:*",
        "secretsmanager:*",
        "acm:*",
        "wafv2:*",
        "ecr:*",
        "sqs:*",
        "lambda:*",
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:PutParameter",
        "ssm:DeleteParameter",
        "ssm:DescribeParameters",
        "ssm:AddTagsToResource",
        "ssm:ListTagsForResource",
        "cognito-idp:*"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-east-2",
            "sa-east-1"
          ]
        }
      }
    },
    {
      "Sid": "CloudFrontGlobal",
      "Effect": "Allow",
      "Action": "cloudfront:*",
      "Resource": "*"
    },
    {
      "Sid": "Lectura",
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity",
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:GetInstanceProfile",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:ListInstanceProfilesForRole"
      ],
      "Resource": "*"
    },
    {
      "Sid": "RolesDelProyecto",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:PassRole",
        "iam:CreateInstanceProfile",
        "iam:DeleteInstanceProfile",
        "iam:TagInstanceProfile",
        "iam:AddRoleToInstanceProfile",
        "iam:RemoveRoleFromInstanceProfile"
      ],
      "Resource": [
        "arn:aws:iam::<AWS_ACCOUNT_ID>:role/minero-*",
        "arn:aws:iam::<AWS_ACCOUNT_ID>:instance-profile/minero-*"
      ]
    },
    {
      "Sid": "RolesVinculadosAServicios",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "*",
      "Condition": {
        "StringLike": {
          "iam:AWSServiceName": [
            "autoscaling.amazonaws.com",
            "elasticloadbalancing.amazonaws.com",
            "rds.amazonaws.com"
          ]
        }
      }
    }
  ]
}
